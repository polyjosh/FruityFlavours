{
  "name": "fruityflavours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "db:local-schema": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/local-schema.sql",
    "admin:password": "node scripts/admin-password.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.16.2",
    "@supabase/supabase-js": "2.57.4",
    "jose": "5.10.0",
    "next": "15.5.4",
    "pglite-prisma-adapter": "0.6.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "postcss": "8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
