// FruityFlavours database (Supabase Postgres). Money is whole KES integers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  customer
  admin
  staff
}

enum ProductType {
  drink
  other
}

enum Availability {
  on_sale
  out_of_stock
  coming_soon
  hidden
}

enum Fulfilment {
  delivery
  pickup
}

enum OrderStatus {
  awaiting_payment
  new
  preparing
  ready
  out_for_delivery
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  cod
}

enum PaymentMethod {
  mpesa
  cod
  card
}

enum PaymentAttemptStatus {
  initiated
  success
  failed
  timeout
}

enum NotificationChannel {
  sms
  email
  whatsapp
  in_app
}

enum NotificationStatus {
  queued
  sent
  failed
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  phone           String    @unique
  email           String?
  passwordHash    String?   @map("password_hash")
  role            Role      @default(customer)
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  addresses     Address[]
  orders        Order[]
  notifications Notification[]

  @@map("users")
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String?
  line1     String
  area      String?
  landmark  String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model OtpCode {
  id        String    @id @default(uuid()) @db.Uuid
  phone     String
  purpose   String    @default("verify")
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([phone])
  @@map("otp_codes")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id           String       @id @default(uuid()) @db.Uuid
  categoryId   String       @map("category_id") @db.Uuid
  type         ProductType
  name         String
  slug         String       @unique
  description  String       @default("")
  emoji        String?
  color        String?
  availability Availability @default(on_sale)
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  category    Category            @relation(fields: [categoryId], references: [id])
  options     ProductOption[]
  photos      ProductPhoto[]
  ingredients ProductIngredient[]
  orderItems  OrderItem[]

  @@map("products")
}

model ProductOption {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  bottlesCount Int?     @map("bottles_count")
  volumeMl     Int?     @map("volume_ml")
  label        String?
  price        Int
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_options")
}

model ProductPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  path      String?
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_photos")
}

model Ingredient {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  productId    String @map("product_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@map("product_ingredients")
}

model PickupPoint {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  address      String?
  openingHours String?  @map("opening_hours")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("pickup_points")
}

/// Planned for later; unused at first (the flat delivery fee lives in settings).
model DeliveryZone {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  fee       Int
  minOrder  Int      @default(0) @map("min_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("delivery_zones")
}

model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  /// Shown as FF-<orderNo>. The seed restarts the sequence at 1001.
  orderNo             Int           @unique @default(autoincrement()) @map("order_no")
  userId              String?       @map("user_id") @db.Uuid
  customerName        String        @map("customer_name")
  customerPhone       String        @map("customer_phone")
  customerEmail       String?       @map("customer_email")
  fulfilment          Fulfilment
  deliveryAddressText String?       @map("delivery_address_text")
  lat                 Float?
  lng                 Float?
  pickupPointId       String?       @map("pickup_point_id") @db.Uuid
  pickupPointName     String?       @map("pickup_point_name")
  subtotal            Int
  deliveryFee         Int           @map("delivery_fee")
  total               Int
  paymentMethod       PaymentMethod @map("payment_method")
  status              OrderStatus
  paymentStatus       PaymentStatus @map("payment_status")
  notes               String?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  pickupPoint   PickupPoint?         @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  notifications Notification[]

  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id           String      @id @default(uuid()) @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  productId    String?     @map("product_id") @db.Uuid
  optionId     String?     @map("option_id") @db.Uuid
  productName  String      @map("product_name")
  productType  ProductType @map("product_type")
  categoryName String      @map("category_name")
  optionLabel  String      @map("option_label")
  bottlesCount Int?        @map("bottles_count")
  volumeMl     Int?        @map("volume_ml")
  unitPrice    Int         @map("unit_price")
  quantity     Int
  lineTotal    Int         @map("line_total")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  option  ProductOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String?      @map("changed_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model Payment {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @map("order_id") @db.Uuid
  method            PaymentMethod
  amount            Int
  phone             String?
  checkoutRequestId String?              @unique @map("checkout_request_id")
  merchantRequestId String?              @map("merchant_request_id")
  mpesaReceipt      String?              @unique @map("mpesa_receipt")
  resultCode        Int?                 @map("result_code")
  resultDesc        String?              @map("result_desc")
  status            PaymentAttemptStatus @default(initiated)
  rawCallback       Json?                @map("raw_callback")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String?             @map("user_id") @db.Uuid
  orderId     String?             @map("order_id") @db.Uuid
  channel     NotificationChannel
  template    String
  recipient   String
  body        String
  status      NotificationStatus  @default(queued)
  providerRef String?             @map("provider_ref")
  error       String?
  attempts    Int                 @default(0)
  sentAt      DateTime?           @map("sent_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_log")
}

/// Failed admin sign-ins, used for the "tries left before a 5-minute pause" lockout.
model AdminLoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  ip        String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@map("admin_login_attempts")
}
