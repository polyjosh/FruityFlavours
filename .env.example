# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-photos

# Supabase Postgres (Connect -> ORMs -> Prisma). Leave both empty to use the local PGlite database in .data/.
# Transaction pooler, port 6543, with ?pgbouncer=true
DATABASE_URL=
# Session pooler or direct connection, port 5432 (used for migrations)
DIRECT_URL=

# Sessions and admin
# At least 32 random characters
JWT_SECRET=
# Set with: npm run admin:password -- "your password"  (base64 of an argon2 hash)
ADMIN_PASSWORD_HASH=
# Phone that gets a "new order" SMS (optional)
ADMIN_ALERT_PHONE=

# Safaricom Daraja (sandbox first)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=

# Africa's Talking SMS
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
